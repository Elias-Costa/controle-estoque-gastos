{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.testes.tsbuildinfo",
    "target": "es2023",
    /* `DOM` entrou em E-05 e é só por tipos: `fake-indexeddb` declara suas classes como
       `typeof IDBFactory` etc., nomes que vivem na lib DOM. O runtime dos testes continua
       sendo o Bun, sem `document` nem `window` — um teste que os use compila e quebra. */
    "lib": ["ES2023", "DOM"],
    "types": ["bun"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /* `nuvem` entrou em E-06: o runner de migrations e a suíte de integração são TypeScript que
     roda no Bun, fora de `src` — mesmo runtime e mesmos tipos dos testes. `ferramentas` entrou
     em E-13 pelo mesmo motivo (o gerador de ícones roda no Bun, sobre o Playwright). */
  "include": ["testes", "nuvem", "ferramentas"]
}
