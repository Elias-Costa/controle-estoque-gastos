{
  "name": "controle-estoque-fiado",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "LAN=1 vite --host",
    "build": "tsc -b && vite build",
    "build:laboratorio": "bun --no-env-file run ferramentas/testar-ambiente.ts local build",
    "preview": "vite preview",
    "preview:lan": "LAN=1 vite preview --host --port 5173",
    "preview:laboratorio": "vite preview --outDir dist-laboratorio --port 4174 --strictPort",
    "preview:laboratorio:lan": "LAN=1 vite preview --outDir dist-laboratorio --host --port 4174 --strictPort",
    "build:local": "VITE_SUPABASE_URL= VITE_SUPABASE_ANON_KEY= vite build --outDir dist-local",
    "preview:local": "vite preview --outDir dist-local --port 4175 --strictPort",
    "preview:local:lan": "LAN=1 vite preview --outDir dist-local --host --port 4175 --strictPort",
    "prototipo": "vite prototipo --port 5174 --host",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint",
    "test": "bun test",
    "local:iniciar": "bun --no-env-file run ferramentas/testar-ambiente.ts local iniciar",
    "local:parar": "bun --no-env-file run ferramentas/testar-ambiente.ts local parar",
    "migrar:local": "bun --no-env-file run ferramentas/testar-ambiente.ts local migrar",
    "migrar:local:reverter": "bun --no-env-file run ferramentas/testar-ambiente.ts local reverter",
    "test:integracao": "bun run test:integracao:local",
    "test:integracao:local": "bun --no-env-file run ferramentas/testar-ambiente.ts local integracao",
    "test:integracao:homologacao": "bun --no-env-file run ferramentas/testar-ambiente.ts homologacao integracao",
    "test:navegador": "bun run test:navegador:local",
    "test:navegador:local": "bun --no-env-file run ferramentas/testar-ambiente.ts local navegador",
    "test:navegador:homologacao": "bun --no-env-file run ferramentas/testar-ambiente.ts homologacao navegador",
    "test:interface": "bun run build:local && playwright test --config playwright-interface.config.ts",
    "migrar:homologacao": "bun --no-env-file run ferramentas/testar-ambiente.ts homologacao migrar",
    "migrar": "bun run nuvem/migrar.ts",
    "migrar:reverter": "bun --no-env-file run ferramentas/testar-ambiente.ts local reverter",
    "icones": "bun run ferramentas/gerar-icones.ts",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "@tailwindcss/vite": "^4.3.3",
    "@zip.js/zip.js": "2.24.0",
    "dexie": "^4.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "^1.79.0",
    "supabase": "2.119.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
