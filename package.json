{
  "name": "controle-estoque-fiado",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "LAN=1 vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:lan": "LAN=1 vite preview --host --port 5173",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "dexie": "^4.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/bun": "^1.4.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
